    "@angular/core": "^21.0.0 || ^22.0.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@angular/core": "22.1.3",
    "@nx/js": "23.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "nx": "23.1.1",
    "rxjs": "7.8.2",
    "typescript": "~6.0.0",
    "vitest": "4.1.10"
  }
